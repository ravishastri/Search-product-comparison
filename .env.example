# Copy this file to .env and fill in the values. .env is gitignored; never commit real keys.

# Required
TAVILY_API_KEY="tvly-..."
NEBIUS_API_KEY="..."

# Optional: Langfuse tracing. Leave the two keys empty to turn tracing off.
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
# Region URL. Use the one that matches your project (this one is US Cloud).
# Self-hosted: set this to your own server URL.
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
